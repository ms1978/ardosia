# Token de acesso à API
MS78_API_TOKEN=muda_este_token

# Pasta local onde ficam os diários (monta como volume Docker)
VAULT_PATH=./caderno

# Destino rsync para o botão Sincronizar (ex: user@192.168.1.x:/caminho/caderno)
# Deixar vazio para desativar o botão
SYNC_TARGET=

# UID/GID do utilizador do host (ficheiros ficam com as permissões certas)
# Descobrir com: id -u  e  id -g
PUID=1000
PGID=1000
